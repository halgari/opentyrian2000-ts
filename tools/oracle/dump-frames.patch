+/* ---- virtual clock ---- */
+static int fast = -1;
+static Uint32 vclock = 1000;
+
+static int is_fast(void)
+{
+	if (fast < 0)
+	{
+		const char *s = getenv("OT_FAST");
+		fast = s && *s && *s != '0';
+	}
+	return fast;
+}
+
+Uint32 oracle_ticks(void)
+{
+	return is_fast() ? vclock : SDL_GetTicks();
+}
+
+static void inject_idle(void);
+static unsigned long idle_polls, idle_limit = 2000;
+
+void oracle_delay(Uint32 ms)
+{
+	inject_idle();
+	if (is_fast())
+		vclock += ms;
+	else
+		SDL_Delay(ms);
+}
+
+static void save_dump(void);
+
+unsigned long oracle_seed(unsigned long fallback)
+{
+	const char *ip = getenv("OT_IDLE_POLLS");
+	if (ip && *ip) idle_limit = strtoul(ip, NULL, 10);
+	if (getenv("OT_SAVEDUMP")) atexit(save_dump);
+	const char *s = getenv("OT_SEED");
+	const char *d = getenv("OT_DEMO");
+	(void)fallback;
+	if (d)
+		demo_num = (Uint8)(strtoul(d, NULL, 10) - 1); /* load_next_demo does ++demo_num */
+	return s ? strtoul(s, NULL, 10) : 1UL;
+}
+
+/* ---- crc32 (zlib) ---- */
+static Uint32 crc_table[256];
+
+static Uint32 crc32_update(Uint32 crc, const Uint8 *p, size_t n)
+{
+	if (!crc_table[1])
+		for (Uint32 i = 0; i < 256; ++i)
+		{
+			Uint32 c = i;
+			for (int k = 0; k < 8; ++k)
+				c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+			crc_table[i] = c;
+		}
+	crc = ~crc;
+	while (n--)
+		crc = crc_table[(crc ^ *p++) & 0xFF] ^ (crc >> 8);
+	return ~crc;
+}
+
+/* ---- key / mouse injection ---- */
+enum { ACT_TAP, ACT_DOWN, ACT_UP, ACT_MOTION, ACT_BTN_DOWN, ACT_BTN_UP, ACT_TYPE };
+typedef struct { unsigned long frame; int kind; int a, b; int fired; } Action;
+static Action *acts;
+static size_t nacts, capacts, nextact;
+static int acts_loaded;
+static int mouse_wx, mouse_wy;
+
+static void add_act(unsigned long f, int kind, int a, int b)
+{
+	if (nacts == capacts)
+	{
+		capacts = capacts ? capacts * 2 : 64;
+		acts = realloc(acts, capacts * sizeof(*acts));
+	}
+	acts[nacts].frame = f; acts[nacts].kind = kind; acts[nacts].a = a; acts[nacts].b = b; acts[nacts].fired = 0;
+	nacts++;
+}
+
+static int act_cmp(const void *x, const void *y)
+{
+	const Action *p = x, *q = y;
+	return p->frame < q->frame ? -1 : p->frame > q->frame ? 1 : 0;
+}
+
+/* stable sort by frame: stash the original index in `fired` */
+static int act_cmp_stable(const void *x, const void *y)
+{
+	int c = act_cmp(x, y);
+	return c ? c : ((const Action *)x)->fired - ((const Action *)y)->fired;
+}
+
+static void load_acts(void)
+{
+	const char *keys = getenv("OT_KEYS");
+	acts_loaded = 1;
+	while (keys && *keys)
+	{
+		unsigned long kf = strtoul(keys, (char **)&keys, 10);
+		if (*keys != ':') break;
+		keys++;
+		int sc = (int)strtol(keys, (char **)&keys, 10);
+		unsigned long hold = 0;
+		if (*keys == ':') { keys++; hold = strtoul(keys, (char **)&keys, 10); }
+		if (hold == 0)
+			add_act(kf, ACT_TAP, sc, 0);
+		else
+		{
+			add_act(kf, ACT_DOWN, sc, 0);
+			add_act(kf + hold, ACT_UP, sc, 0);
+		}
+		if (*keys == ',') keys++;
+	}
+	const char *mouse = getenv("OT_MOUSE");
+	while (mouse && *mouse)
+	{
+		unsigned long mf = strtoul(mouse, (char **)&mouse, 10);
+		if (*mouse != ':') break;
+		mouse++;
+		char t = *mouse++;
+		if (*mouse != ':') break;
+		mouse++;
+		int a = (int)strtol(mouse, (char **)&mouse, 10), b = 0;
+		if (t == 'm')
+		{
+			if (*mouse != ':') break;
+			mouse++;
+			b = (int)strtol(mouse, (char **)&mouse, 10);
+			add_act(mf, ACT_MOTION, a, b);
+		}
+		else
+			add_act(mf, t == 'd' ? ACT_BTN_DOWN : ACT_BTN_UP, a, 0);
+		if (*mouse == ',') mouse++;
+	}
+	const char *text = getenv("OT_TEXT");
+	while (text && *text)
+	{
+		unsigned long tf = strtoul(text, (char **)&text, 10);
+		if (*text != ':') break;
+		text++;
+		int sc = (int)strtol(text, (char **)&text, 10);
+		if (*text != ':') break;
+		text++;
+		int code = (int)strtol(text, (char **)&text, 10);
+		add_act(tf, ACT_TYPE, sc, code);
+		if (*text == ',') text++;
+	}
+	for (size_t i = 0; i < nacts; ++i) acts[i].fired = (int)i;
+	qsort(acts, nacts, sizeof(*acts), act_cmp_stable);
+	for (size_t i = 0; i < nacts; ++i) acts[i].fired = 0;
+}
+
+static void push_key(int down, int sc)
+{
+	SDL_Event ev;
+	memset(&ev, 0, sizeof(ev));
+	ev.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+	ev.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+	ev.key.keysym.scancode = (SDL_Scancode)sc;
+	SDL_PushEvent(&ev);
+}
+
+static void fire_act(const Action *a)
+{
+	SDL_Event ev;
+	memset(&ev, 0, sizeof(ev));
+	switch (a->kind)
+	{
+	case ACT_TAP: push_key(1, a->a); push_key(0, a->a); break;
+	case ACT_TYPE:
+		push_key(1, a->a);
+		/* SDL_PushEvent of a real SDL_TEXTINPUT crashes under sdl2-compat; keyboard.c turns this user event into one */
+		ev.type = SDL_USEREVENT;
+		ev.user.code = 0x7e57;
+		ev.user.data1 = (void *)(intptr_t)a->b;
+		SDL_PushEvent(&ev);
+		push_key(0, a->a);
+		break;
+	case ACT_DOWN: push_key(1, a->a); break;
+	case ACT_UP: push_key(0, a->a); break;
+	case ACT_MOTION:
+		mouse_wx += a->a; mouse_wy += a->b;
+		ev.type = SDL_MOUSEMOTION;
+		ev.motion.x = mouse_wx; ev.motion.y = mouse_wy;
+		ev.motion.xrel = a->a; ev.motion.yrel = a->b;
+		SDL_PushEvent(&ev);
+		break;
+	case ACT_BTN_DOWN: case ACT_BTN_UP:
+		ev.type = a->kind == ACT_BTN_DOWN ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+		ev.button.state = a->kind == ACT_BTN_DOWN ? SDL_PRESSED : SDL_RELEASED;
+		ev.button.button = (Uint8)a->a;
+		ev.button.x = mouse_wx; ev.button.y = mouse_wy;
+		SDL_PushEvent(&ev);
+		break;
+	}
+}
+
+/* Normal rule: after frame f is presented, fire every pending entry with frame <= f, in order. */
+static void inject_keys(unsigned long f)
+{
+	if (!acts_loaded) load_acts();
+	while (nextact < nacts && acts[nextact].frame <= f)
+		fire_act(&acts[nextact++]);
+}
+
+/* Idle rule (called from every SDL_Delay): after idle_limit polls without a presented frame, fire
+ * the head pending entry and every following entry with the same frame number. */
+static void inject_idle(void)
+{
+	if (!acts_loaded) load_acts();
+	if (nextact >= nacts) return;
+	if (++idle_polls < idle_limit) return;
+	idle_polls = 0;
+	{
+		const char *lp = getenv("OT_IDLELOG");
+		FILE *lf = lp ? fopen(lp, "a") : NULL;
+		if (lf) { fprintf(lf, "%ld\n", (long)frame - 1); fclose(lf); }
+	}
+	unsigned long f = acts[nextact].frame;
+	while (nextact < nacts && acts[nextact].frame == f)
+		fire_act(&acts[nextact++]);
+}
+
+static void save_dump(void)
+{
+	const char *dir = getenv("OT_SAVEDUMP");
+	static const char *const names[] = { "tyrian.sav", "tyrian.cfg", "opentyrian.cfg" };
+	if (!dir) return;
+	mkdir(dir, 0755);
+	for (int i = 0; i < 3; ++i)
+	{
+		char src[600], dst[600];
+		snprintf(src, sizeof(src), "%s/%s", get_user_directory(), names[i]);
+		snprintf(dst, sizeof(dst), "%s/%s", dir, names[i]);
+		FILE *in = fopen(src, "rb");
+		if (!in) continue;
+		FILE *out = fopen(dst, "wb");
+		char buf[4096];
+		size_t n;
+		while (out && (n = fread(buf, 1, sizeof(buf), in)) > 0) fwrite(buf, 1, n, out);
+		if (out) fclose(out);
+		fclose(in);
+	}
+}
+
+static int raw_selected(unsigned long f)
+{
+	if (!raw_filter) return 1;
+	if (raw_every && f % raw_every == 0) return 1;
+	for (const char *s = raw_frames; s && *s;)
+	{
+		unsigned long a = strtoul(s, (char **)&s, 10), b = a;
+		if (*s == '-') { s++; b = strtoul(s, (char **)&s, 10); }
+		if (f >= a && f <= b) return 1;
+		if (*s == ',') s++; else if (*s) return 0;
+	}
+	return 0;
+}
+
+/* State record: 16 x u32 little-endian, in this order. Fields that do not exist yet
+ * (before a level has started) are naturally 0 because the C globals are zero-initialised.
+ * Live counts (checked against tyrian2.c):
+ *   liveEnemies      = #{ i : enemyAvail[i] != 1 }       (1 = free slot, 0 = active, 2 = being removed)
+ *   livePlayerShots  = #{ i : shotAvail[i]  != 0 }       (0 = free slot, tyrian2.c:1442)
+ *   liveEnemyShots   = #{ i : enemyShotAvail[i] == 0 }   (1 = free slot, 0 = active, tyrian2.c:1780)
+ *   liveExplosions   = #{ i : explosions[i].ttl != 0 }
+ * p0x/p0y are the C ints cast to u32. */
+static void write_state(unsigned long f)
+{
+	Uint32 r[16];
+	Uint32 i, n;
+	r[0] = (Uint32)f;
+	r[1] = (Uint32)oracle_mt_calls;
+	r[2] = curLoc;
+	r[3] = eventLoc;
+	r[4] = (Uint32)player[0].x;
+	r[5] = (Uint32)player[0].y;
+	r[6] = player[0].shield;
+	r[7] = player[0].armor;
+	r[8] = (Uint32)player[0].cash;
+	r[9] = enemyOnScreen;
+	for (n = 0, i = 0; i < sizeof(enemyAvail) / sizeof(enemyAvail[0]); ++i) n += enemyAvail[i] != 1;
+	r[10] = n;
+	for (n = 0, i = 0; i < MAX_PWEAPON; ++i) n += shotAvail[i] != 0;
+	r[11] = n;
+	for (n = 0, i = 0; i < ENEMY_SHOT_MAX; ++i) n += enemyShotAvail[i] == 0;
+	r[12] = n;
+	for (n = 0, i = 0; i < MAX_EXPLOSIONS; ++i) n += explosions[i].ttl != 0;
+	r[13] = n;
+	r[14] = backPos;
+	r[15] = mapY;
+	/* host is little-endian (x86-64 Linux) */
+	fwrite(r, 4, 16, statef);
+	fflush(statef);
+}
+
+extern int oracle_cur_menu(void); /* game_menu.c */
+
+/* State record v2: 36 x 32-bit little-endian words (s32 where marked), in this order:
+ *  0 frame            1 mtCalls          2 cash (low 32 bits of player[0].cash)
+ *  3 front power      4 rear power       5..16 items[12] (pItems order: front id, rear id, super_arcade,
+ *  sidekick L, sidekick R, generator, sidekick_level, sidekick_series, initial_episode_num, shield, special, ship)
+ * 17 mainLevel       18 nextLevel       19 saveLevel       20 episodeNum
+ * 21 difficultyLevel (s32)  22 levelEnd  23 endLevel  24 reallyEndLevel  25 gameLoaded
+ * 26 curMenu (s32)   27 lvlFileNum      28 armor          29 shield
+ * 30 temp  31 temp2  32 temp3  33 tempW   34 p0 x (s32)    35 p0 y (s32) */
+static void write_state2(unsigned long f)
+{
+	Uint32 r[36];
+	int k = 0;
+	r[k++] = (Uint32)f;
+	r[k++] = (Uint32)oracle_mt_calls;
+	r[k++] = (Uint32)player[0].cash;
+	r[k++] = player[0].items.weapon[FRONT_WEAPON].power;
+	r[k++] = player[0].items.weapon[REAR_WEAPON].power;
+	r[k++] = player[0].items.weapon[FRONT_WEAPON].id;
+	r[k++] = player[0].items.weapon[REAR_WEAPON].id;
+	r[k++] = player[0].items.super_arcade_mode;
+	r[k++] = player[0].items.sidekick[LEFT_SIDEKICK];
+	r[k++] = player[0].items.sidekick[RIGHT_SIDEKICK];
+	r[k++] = player[0].items.generator;
+	r[k++] = player[0].items.sidekick_level;
+	r[k++] = player[0].items.sidekick_series;
+	r[k++] = initial_episode_num;
+	r[k++] = player[0].items.shield;
+	r[k++] = player[0].items.special;
+	r[k++] = player[0].items.ship;
+	r[k++] = mainLevel;
+	r[k++] = nextLevel;
+	r[k++] = saveLevel;
+	r[k++] = episodeNum;
+	r[k++] = (Uint32)(Sint32)difficultyLevel;
+	r[k++] = levelEnd;
+	r[k++] = endLevel;
+	r[k++] = reallyEndLevel;
+	r[k++] = gameLoaded;
+	r[k++] = (Uint32)(Sint32)oracle_cur_menu();
+	r[k++] = lvlFileNum;
+	r[k++] = player[0].armor;
+	r[k++] = player[0].shield;
+	r[k++] = temp;
+	r[k++] = temp2;
+	r[k++] = temp3;
+	r[k++] = tempW;
+	r[k++] = (Uint32)(Sint32)player[0].x;
+	r[k++] = (Uint32)(Sint32)player[0].y;
+	fwrite(r, 4, 36, state2f);
+	fflush(state2f);
+}
+
+/* State record v3: 16 x 32-bit little-endian words (s32 where marked), in this order:
+ *  0 frame  1 player[1].x (s32)  2 player[1].y (s32)  3 player[1].armor  4 player[1].shield  5 player[1].cash (low 32 bits)
+ *  6 player[1].is_alive  7 flags: bit0 twoPlayerMode, 1 twoPlayerLinked, 2 galagaMode, 3 timedBattleMode, 4 onePlayerAction,
+ *  5 superTyrian, bits 8.. superArcadeMode   8 linkGunDirec (float bits)   9 galagaLife (s32)   10 galagaShotFreq
+ * 11 levelTimerCountdown  12 player[1] front weapon id  13 front power  14 rear weapon id  15 player[1] ship */
+static void write_state3(unsigned long f)
+{
+	Uint32 r[16];
+	union { float f; Uint32 u; } d;
+	int k = 0;
+	d.f = linkGunDirec;
+	r[k++] = (Uint32)f;
+	r[k++] = (Uint32)(Sint32)player[1].x;
+	r[k++] = (Uint32)(Sint32)player[1].y;
+	r[k++] = player[1].armor;
+	r[k++] = player[1].shield;
+	r[k++] = (Uint32)player[1].cash;
+	r[k++] = player[1].is_alive;
+	r[k++] = (twoPlayerMode ? 1 : 0) | (twoPlayerLinked ? 2 : 0) | (galagaMode ? 4 : 0) | (timedBattleMode ? 8 : 0) |
+	         (onePlayerAction ? 16 : 0) | (superTyrian ? 32 : 0) | ((Uint32)superArcadeMode << 8);
+	r[k++] = d.u;
+	r[k++] = (Uint32)galagaLife;
+	r[k++] = galagaShotFreq;
+	r[k++] = levelTimerCountdown;
+	r[k++] = player[1].items.weapon[FRONT_WEAPON].id;
+	r[k++] = player[1].items.weapon[FRONT_WEAPON].power;
+	r[k++] = player[1].items.weapon[REAR_WEAPON].id;
+	r[k++] = player[1].items.ship;
+	fwrite(r, 4, 16, state3f);
+	fflush(state3f);
+}
+
+void oracle_frame(SDL_Surface *screen)
+{
+	if (!initialized)
+	{
+		initialized = 1;
+		const char *path = getenv("OT_DUMP");
+		if (path) dump = fopen(path, "wb");
+		path = getenv("OT_HASH");
+		if (path) hashf = fopen(path, "wb");
+		path = getenv("OT_STATE");
+		if (path) statef = fopen(path, "wb");
+		path = getenv("OT_STATE2");
+		if (path) state2f = fopen(path, "wb");
+		path = getenv("OT_STATE3");
+		if (path) state3f = fopen(path, "wb");
+		const char *m = getenv("OT_MAX_FRAMES");
+		max_frames = m ? strtoul(m, NULL, 10) : 0;
+		const char *e = getenv("OT_RAW_EVERY");
+		raw_every = e ? strtoul(e, NULL, 10) : 0;
+		raw_frames = getenv("OT_RAW_FRAMES");
+		raw_filter = raw_every != 0 || (raw_frames && *raw_frames);
+	}
+	if (dump || hashf)
+	{
+		Uint8 pal[768];
+		Uint32 f32 = (Uint32)frame;
+		oracle_get_palette(pal);
+		if (dump && raw_selected(frame))
+		{
+			fwrite(&f32, 4, 1, dump);
+			fwrite(pal, 768, 1, dump);
+			for (int y = 0; y < screen->h; ++y)
+				fwrite((Uint8 *)screen->pixels + y * screen->pitch, 1, screen->w, dump);
+			fflush(dump);
+		}
+		if (hashf)
+		{
+			Uint32 crc = crc32_update(0, pal, 768);
+			for (int y = 0; y < screen->h; ++y)
+				crc = crc32_update(crc, (Uint8 *)screen->pixels + y * screen->pitch, screen->w);
+			fwrite(&f32, 4, 1, hashf);
+			fwrite(&crc, 4, 1, hashf);
+			fflush(hashf);
+		}
+	}
+	if (statef) write_state(frame);
+	if (state2f) write_state2(frame);
+	if (state3f) write_state3(frame);
+	inject_keys(frame);
+	idle_polls = 0;
+	frame++;
+	if (max_frames && frame >= max_frames)
+	{
+		if (dump) fclose(dump);
+		if (hashf) fclose(hashf);
+		if (statef) fclose(statef);
+		if (state2f) fclose(state2f);
+		if (state3f) fclose(state3f);
+		exit(0);
+	}
+}
