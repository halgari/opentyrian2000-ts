diff --git a/src/oracle.c b/src/oracle.c
new file mode 100644
index 0000000..f832d39
--- /dev/null
+++ b/src/oracle.c
@@ -0,0 +1,221 @@
+/* Reference-oracle hooks for opentyrian2000-ts (not part of upstream).
+ * OT_DUMP=path       append one raw record per JE_showVGA: u32 frame, 768 palette bytes, 64000 pixels
+ * OT_RAW_EVERY=n     with OT_DUMP: only dump frames where frame % n == 0 ...
+ * OT_RAW_FRAMES=a,b-c ... plus the listed frames (a single frame or an inclusive a-b range).
+ *                    If either of the two is set, only the selected frames are dumped.
+ * OT_HASH=path       append one record per JE_showVGA: u32 frame, u32 crc32(palette(768) || pixels(64000))
+ * OT_STATE=path      append one state record per JE_showVGA: 16 x u32 LE, see oracle_state below
+ * OT_DEMO=n          presets demo_num = n-1 so the next demo played is demo.n (n in 1..5)
+ * OT_FAST=1          virtual clock: SDL_GetTicks/SDL_Delay never block (see oracle.h)
+ * OT_SEED=n          mt_srand seed (default 1)
+ * OT_MAX_FRAMES=n    exit(0) after n frames have been dumped
+ * OT_KEYS=f:sc,...   after frame f is presented, inject key down+up for SDL scancode sc
+ */
+#define ORACLE_NO_CLOCK_MACROS
+#include "oracle.h"
+#include "backgrnd.h"
+#include "palette.h"
+#include "player.h"
+#include "shots.h"
+#include "varz.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern unsigned long oracle_mt_calls; /* mtrand.c: incremented on every mt_rand() */
+extern Uint8 demo_num;                /* varz.c */
+void oracle_get_palette(Uint8 out[768]);
+
+static FILE *dump, *hashf, *statef;
+static int initialized;
+static unsigned long frame;
+static unsigned long max_frames;
+static unsigned long raw_every;
+static const char *raw_frames;
+static int raw_filter;
+
+/* ---- virtual clock ---- */
+static int fast = -1;
+static Uint32 vclock = 1000;
+
+static int is_fast(void)
+{
+	if (fast < 0)
+	{
+		const char *s = getenv("OT_FAST");
+		fast = s && *s && *s != '0';
+	}
+	return fast;
+}
+
+Uint32 oracle_ticks(void)
+{
+	return is_fast() ? vclock : SDL_GetTicks();
+}
+
+void oracle_delay(Uint32 ms)
+{
+	if (is_fast())
+		vclock += ms;
+	else
+		SDL_Delay(ms);
+}
+
+unsigned long oracle_seed(unsigned long fallback)
+{
+	const char *s = getenv("OT_SEED");
+	const char *d = getenv("OT_DEMO");
+	(void)fallback;
+	if (d)
+		demo_num = (Uint8)(strtoul(d, NULL, 10) - 1); /* load_next_demo does ++demo_num */
+	return s ? strtoul(s, NULL, 10) : 1UL;
+}
+
+/* ---- crc32 (zlib) ---- */
+static Uint32 crc_table[256];
+
+static Uint32 crc32_update(Uint32 crc, const Uint8 *p, size_t n)
+{
+	if (!crc_table[1])
+		for (Uint32 i = 0; i < 256; ++i)
+		{
+			Uint32 c = i;
+			for (int k = 0; k < 8; ++k)
+				c = (c & 1) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+			crc_table[i] = c;
+		}
+	crc = ~crc;
+	while (n--)
+		crc = crc_table[(crc ^ *p++) & 0xFF] ^ (crc >> 8);
+	return ~crc;
+}
+
+/* ---- key injection ---- */
+static void inject_keys(unsigned long f)
+{
+	const char *keys = getenv("OT_KEYS");
+	while (keys && *keys)
+	{
+		unsigned long kf = strtoul(keys, (char **)&keys, 10);
+		if (*keys != ':') return;
+		keys++;
+		int sc = (int)strtol(keys, (char **)&keys, 10);
+		if (kf == f)
+		{
+			SDL_Event ev;
+			memset(&ev, 0, sizeof(ev));
+			ev.type = SDL_KEYDOWN;
+			ev.key.state = SDL_PRESSED;
+			ev.key.keysym.scancode = (SDL_Scancode)sc;
+			SDL_PushEvent(&ev);
+			ev.type = SDL_KEYUP;
+			ev.key.state = SDL_RELEASED;
+			SDL_PushEvent(&ev);
+		}
+		if (*keys == ',') keys++;
+	}
+}
+
+static int raw_selected(unsigned long f)
+{
+	if (!raw_filter) return 1;
+	if (raw_every && f % raw_every == 0) return 1;
+	for (const char *s = raw_frames; s && *s;)
+	{
+		unsigned long a = strtoul(s, (char **)&s, 10), b = a;
+		if (*s == '-') { s++; b = strtoul(s, (char **)&s, 10); }
+		if (f >= a && f <= b) return 1;
+		if (*s == ',') s++; else if (*s) return 0;
+	}
+	return 0;
+}
+
+/* State record: 16 x u32 little-endian, in this order. Fields that do not exist yet
+ * (before a level has started) are naturally 0 because the C globals are zero-initialised.
+ * Live counts (checked against tyrian2.c):
+ *   liveEnemies      = #{ i : enemyAvail[i] != 1 }       (1 = free slot, 0 = active, 2 = being removed)
+ *   livePlayerShots  = #{ i : shotAvail[i]  != 0 }       (0 = free slot, tyrian2.c:1442)
+ *   liveEnemyShots   = #{ i : enemyShotAvail[i] == 0 }   (1 = free slot, 0 = active, tyrian2.c:1780)
+ *   liveExplosions   = #{ i : explosions[i].ttl != 0 }
+ * p0x/p0y are the C ints cast to u32. */
+static void write_state(unsigned long f)
+{
+	Uint32 r[16];
+	Uint32 i, n;
+	r[0] = (Uint32)f;
+	r[1] = (Uint32)oracle_mt_calls;
+	r[2] = curLoc;
+	r[3] = eventLoc;
+	r[4] = (Uint32)player[0].x;
+	r[5] = (Uint32)player[0].y;
+	r[6] = player[0].shield;
+	r[7] = player[0].armor;
+	r[8] = (Uint32)player[0].cash;
+	r[9] = enemyOnScreen;
+	for (n = 0, i = 0; i < sizeof(enemyAvail) / sizeof(enemyAvail[0]); ++i) n += enemyAvail[i] != 1;
+	r[10] = n;
+	for (n = 0, i = 0; i < MAX_PWEAPON; ++i) n += shotAvail[i] != 0;
+	r[11] = n;
+	for (n = 0, i = 0; i < ENEMY_SHOT_MAX; ++i) n += enemyShotAvail[i] == 0;
+	r[12] = n;
+	for (n = 0, i = 0; i < MAX_EXPLOSIONS; ++i) n += explosions[i].ttl != 0;
+	r[13] = n;
+	r[14] = backPos;
+	r[15] = mapY;
+	/* host is little-endian (x86-64 Linux) */
+	fwrite(r, 4, 16, statef);
+	fflush(statef);
+}
+
+void oracle_frame(SDL_Surface *screen)
+{
+	if (!initialized)
+	{
+		initialized = 1;
+		const char *path = getenv("OT_DUMP");
+		if (path) dump = fopen(path, "wb");
+		path = getenv("OT_HASH");
+		if (path) hashf = fopen(path, "wb");
+		path = getenv("OT_STATE");
+		if (path) statef = fopen(path, "wb");
+		const char *m = getenv("OT_MAX_FRAMES");
+		max_frames = m ? strtoul(m, NULL, 10) : 0;
+		const char *e = getenv("OT_RAW_EVERY");
+		raw_every = e ? strtoul(e, NULL, 10) : 0;
+		raw_frames = getenv("OT_RAW_FRAMES");
+		raw_filter = raw_every != 0 || (raw_frames && *raw_frames);
+	}
+	if (dump || hashf)
+	{
+		Uint8 pal[768];
+		Uint32 f32 = (Uint32)frame;
+		oracle_get_palette(pal);
+		if (dump && raw_selected(frame))
+		{
+			fwrite(&f32, 4, 1, dump);
+			fwrite(pal, 768, 1, dump);
+			for (int y = 0; y < screen->h; ++y)
+				fwrite((Uint8 *)screen->pixels + y * screen->pitch, 1, screen->w, dump);
+			fflush(dump);
+		}
+		if (hashf)
+		{
+			Uint32 crc = crc32_update(0, pal, 768);
+			for (int y = 0; y < screen->h; ++y)
+				crc = crc32_update(crc, (Uint8 *)screen->pixels + y * screen->pitch, screen->w);
+			fwrite(&f32, 4, 1, hashf);
+			fwrite(&crc, 4, 1, hashf);
+			fflush(hashf);
+		}
+	}
+	if (statef) write_state(frame);
+	inject_keys(frame);
+	frame++;
+	if (max_frames && frame >= max_frames)
+	{
+		if (dump) fclose(dump);
+		if (hashf) fclose(hashf);
+		if (statef) fclose(statef);
+		exit(0);
+	}
+}
diff --git a/src/oracle.h b/src/oracle.h
new file mode 100644
index 0000000..6ab3841
--- /dev/null
+++ b/src/oracle.h
@@ -0,0 +1,16 @@
+#ifndef ORACLE_H
+#define ORACLE_H
+#include "SDL.h"
+/* Reference-oracle hooks for opentyrian2000-ts (not part of upstream). */
+unsigned long oracle_seed(unsigned long fallback);
+void oracle_frame(SDL_Surface *screen);
+
+/* OT_FAST=1: virtual clock. SDL_GetTicks/SDL_Delay (every use in the game) are redirected so that
+ * waiting never blocks: a delay just advances the virtual clock. Frame content is unaffected. */
+Uint32 oracle_ticks(void);
+void oracle_delay(Uint32 ms);
+#ifndef ORACLE_NO_CLOCK_MACROS
+#define SDL_GetTicks oracle_ticks
+#define SDL_Delay oracle_delay
+#endif
+#endif
diff --git a/src/palette.c b/src/palette.c
index 89c09b2..d814289 100644
--- a/src/palette.c
+++ b/src/palette.c
@@ -183,3 +183,14 @@ static Uint32 rgb_to_yuv(int r, int g, int b)
 	    v = 128 + ((-r + 2 * g - b) >> 3);
 	return (y << 16) + (u << 8) + v;
 }
+
+/* opentyrian2000-ts oracle: current 8-bit palette */
+void oracle_get_palette(Uint8 out[768])
+{
+	for (int i = 0; i < 256; ++i)
+	{
+		out[i * 3 + 0] = palette[i].r;
+		out[i * 3 + 1] = palette[i].g;
+		out[i * 3 + 2] = palette[i].b;
+	}
+}
