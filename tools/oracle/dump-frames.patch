+/* Reference-oracle hooks for opentyrian2000-ts (not part of upstream).
+ * OT_DUMP=path       append one raw record per JE_showVGA: u32 frame, 768 palette bytes, 64000 pixels
+ * OT_RAW_EVERY=n     with OT_DUMP: only dump frames where frame % n == 0 ...
+ * OT_RAW_FRAMES=a,b-c ... plus the listed frames (a single frame or an inclusive a-b range).
+ *                    If either of the two is set, only the selected frames are dumped.
+ * OT_HASH=path       append one record per JE_showVGA: u32 frame, u32 crc32(palette(768) || pixels(64000))
+ * OT_STATE=path      append one state record per JE_showVGA: 16 x u32 LE, see oracle_state below
+ * OT_DEMO=n          presets demo_num = n-1 so the next demo played is demo.n (n in 1..5)
+ * OT_FAST=1          virtual clock: SDL_GetTicks/SDL_Delay never block (see oracle.h)
+ * OT_SEED=n          mt_srand seed (default 1)
+ * OT_MAX_FRAMES=n    exit(0) after n frames have been dumped
+ * OT_STATE2=path     append one v2 state record per JE_showVGA: 36 x u32/s32 LE, see write_state2
+ * OT_STATE3=path     append one v3 state record per JE_showVGA: 16 x u32/s32 LE (player 2, mode flags, galaga/timer), see write_state3
+ * OT_KEYS=f:sc[:hold],...  after frame f is presented, inject key down+up (hold 0 = tap) for SDL scancode sc;
+ *                    with hold h > 0: keydown after frame f, keyup after frame f+h
+ * OT_MOUSE=f:m:dx:dy | f:d:btn | f:u:btn, ...  after frame f: relative motion / button down / button up
+ *                    (SDL button numbers: 1 left, 2 middle, 3 right). Motion coordinates are window
+ *                    coordinates accumulated from (0,0).
+ * OT_TEXT=f:sc:code,...  after frame f: a typed character: keydown sc, a text input event with the ASCII character `code`
+ *                    (decimal), keyup sc (the order SDL delivers a printable key in)
+ * OT_IDLE_POLLS=n    (default 2000; intro logo waits exceed 250 polls) if no frame is presented for n SDL_Delay polls, the next pending
+ *                    OT_KEYS/OT_MOUSE entry (and every other entry with the same frame number) is injected
+ *                    anyway, so keys reach screens that draw once and then block. Entries stay in the order
+ *                    given to the environment (sorted by frame, stable).
+ * OT_IDLELOG=path  append one line (last presented frame index) each time the idle rule fires (discovery runner)
+ * OT_SAVEDUMP=dir    at exit, copy tyrian.sav / tyrian.cfg / opentyrian.cfg from the user dir into dir
+ */
+#define ORACLE_NO_CLOCK_MACROS
+#include "oracle.h"
+#include "backgrnd.h"
+#include "config.h"
+#include "episodes.h"
+#include "keyboard.h"
+#include "palette.h"
