diff --git i/src/palette.c w/src/palette.c
index 89c09b2..d814289 100644
--- i/src/palette.c
+++ w/src/palette.c
@@ -183,3 +183,14 @@ static Uint32 rgb_to_yuv(int r, int g, int b)
 	    v = 128 + ((-r + 2 * g - b) >> 3);
 	return (y << 16) + (u << 8) + v;
 }
+
+/* opentyrian2000-ts oracle: current 8-bit palette */
+void oracle_get_palette(Uint8 out[768])
+{
+	for (int i = 0; i < 256; ++i)
+	{
+		out[i * 3 + 0] = palette[i].r;
+		out[i * 3 + 1] = palette[i].g;
+		out[i * 3 + 2] = palette[i].b;
+	}
+}
