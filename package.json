{
  "name": "opentyrian2000-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data": "tsx tools/pack-data.ts",
    "ref": "bash tools/fetch-reference.sh",
    "oracle:build": "bash tools/oracle/build.sh",
    "oracle:run": "tsx tools/oracle/run.ts",
    "oracle:discover": "tsx tools/oracle/discover.ts",
    "oracle": "pnpm oracle:build && tsx tools/oracle/run.ts all",
    "soak": "SOAK=1 vitest run test/soak",
    "build:single": "tsx tools/build-single.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "fflate": "^0.8.3",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
